[Unit]
Description=OBS Worker Container
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
TimeoutStartSec=5m
ExecStartPre=-/usr/bin/podman rm obsworker
# "--pull newer" leaves the previous image without a tag in the local
# storage. Each service start removes the untagged images.
ExecStartPre=-/usr/bin/podman image prune -f

# podman limits a container to 2048 processes and threads by default.
# All worker instances build in this one container, so parallel builds
# exceed that limit and fail with "fork/exec: resource temporarily
# unavailable".
ExecStart=/usr/bin/podman run --name obsworker --pull newer --net host \
	--uts host --privileged --pids-limit=-1 \
{% if obs_openhpc_community_ip is defined %}
	--add-host obs.openhpc.community:{{ obs_openhpc_community_ip }} \
{% endif %}
	-v /workers/:/workers/:z \
	-v /etc/sysconfig/obs-server:/etc/sysconfig/obs-server:z \
	ghcr.io/openhpc/obs-worker:latest

ExecReload=/usr/bin/podman stop obsworker
ExecReload=/usr/bin/podman rm obsworker
ExecStop=/usr/bin/podman stop obsworker
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
