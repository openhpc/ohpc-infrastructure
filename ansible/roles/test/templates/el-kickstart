{%- if distro.startswith('almalinux') -%}
{%- set type = 'el' -%}
{%- set release = distro[9:] -%}
{%- set base = 'AlmaLinux-'~release~'-latest/' -%}
{%- if inventory_hostname_short.startswith('ohpc-lenovo-repo') -%}
{%- set mirror1_base = 'http://mirrors.nxthost.com/almalinux/'~release~'/' -%}
{%- set mirror2_base = 'http://mirrors.hosterion.ro/almalinux/'~release~'/' -%}
{%- elif inventory_hostname_short.startswith('ohpc-huawei-repo') -%}
{%- set mirror1_base = 'http://mirrors.nju.edu.cn/almalinux/'~release~'/' -%}
{%- set mirror2_base = 'http://mirrors.zju.edu.cn/almalinux/'~release~'/' -%}
{%- endif -%}
{%- elif distro.startswith('rocky') -%}
{%- set type = 'el' -%}
{%- set release = distro[5:] -%}
{%- set base = 'Rocky-'~release~'-latest/' -%}
{%- if inventory_hostname_short.startswith('ohpc-lenovo-repo') -%}
{%- set mirror1_base = 'http://mirrors.nxthost.com/rocky/'~release~'/' -%}
{%- set mirror2_base = 'http://mirrors.nav.ro/rockylinux/'~release~'/' -%}
{%- elif inventory_hostname_short.startswith('ohpc-huawei-repo') -%}
{%- set mirror1_base = 'http://mirror.nyist.edu.cn/rocky/'~release~'/' -%}
{%- set mirror2_base = 'http://mirrors.nju.edu.cn/rocky/'~release~'/' -%}
{%- endif -%}
{%- elif distro.startswith('openEuler') -%}
{%- set type = 'openeuler' -%}
{%- set release = distro[10:] -%}
{%- if release == '22.03' -%}
{%- set SP = 'SP3' -%}
{%- elif release == '24.03' -%}
{%- set SP = 'SP3' -%}
{%- endif -%}
{%- set base = 'openEuler-'~release~'-LTS-'~SP~'-everything/' -%}
{%- if inventory_hostname_short.startswith('ohpc-lenovo-repo') -%}
{%- set mirror1 = 'http://mirror.maeen.sa/openeuler/' -%}
{%- elif inventory_hostname_short.startswith('ohpc-huawei-repo') -%}
{%- set mirror1 = 'http://mirrors.nju.edu.cn/openeuler/' -%}
{%- endif -%}
{%- set mirror1_base = mirror1~'openEuler-'~release~'-LTS-'~SP~'/' -%}
{%- endif -%}
{%- set huawei = inventory_hostname_short.startswith('ohpc-huawei-repo') -%}
{#- External mirrors as (repository name, base URL). On Huawei and for
    openEuler on Lenovo they are not used during the installation, they
    are only added in %post with skip_if_unavailable so that an
    unreachable mirror does not break the upgrade. For EL on Lenovo they
    are used during the installation. The cost keeps them preferred over
    the default repositories of the distribution (cost 1000). -#}
{%- set mirrors_in_post = huawei or type == 'openeuler' -%}
{%- if type == 'el' -%}
{%- set mirrors = [
  ('BaseOSMirror1', mirror1_base~'BaseOS/'~arch~'/os/'),
  ('AppStreamMirror1', mirror1_base~'AppStream/'~arch~'/os/'),
  ('BaseOSMirror2', mirror2_base~'BaseOS/'~arch~'/os/'),
  ('AppStreamMirror2', mirror2_base~'AppStream/'~arch~'/os/'),
] -%}
{%- elif type == 'openeuler' -%}
{%- set mirrors = [
  ('everythingMirror', mirror1_base~'everything/'~arch~'/'),
  ('updateMirror', mirror1_base~'update/'~arch~'/'),
] -%}
{%- endif -%}

text

%packages
@standard
ipmitool
-firewalld
openssl-devel
policycoreutils-python-utils

{% if type == 'el' %}
	python3-pip
{% if release != '8' -%}
	perl-ph
{%- endif %}
{% elif type == 'openeuler' %}
	-gtk2
	-gtk3
	-security-tool
	-libvirt-bash-completion
	-libvirt-libs
	-libvirt-daemon
	-libvirt-daemon-driver-network
	-libvirt-daemon-driver-nwfilter
	-libvirt-daemon-driver-qemu
	-libvirt-daemon-config-nwfilter
	-libvirt-daemon-config-network
	-libvirt-daemon-driver-interface
	-libvirt-daemon-driver-nodedev
	-libvirt-daemon-driver-secret
	-libvirt-client
	-cockpit
	-libvirt-daemon-driver-storage-core
	-libvirt-daemon-driver-storage-disk
	-libvirt-daemon-driver-storage-gluster
	-libvirt-daemon-driver-storage-iscsi-direct
	-libvirt-daemon-driver-storage-mpath
	-libvirt-daemon-driver-storage-rbd
	-libvirt-daemon-driver-storage-scsi
	-libvirt-daemon-driver-storage-iscsi
	-libvirt-daemon-driver-storage-logical
	-libvirt-daemon-driver-storage
	-libvirt
	-virt-manager-common
	-virt-install
	-dkms
	-rsyslog-relp
	-mtr
	-lshw
	-tuned
{% endif %}

%end

lang en_US.UTF-8

{% if inventory_hostname_short.startswith('ohpc-lenovo-repo') %}
	network --hostname=ohpc-lenovo-sms --device=ens2f0 --ip=10.241.58.134 --netmask=255.255.255.240 --gateway=10.241.58.129 --bootproto=static --nameserver=1.1.1.1
{% endif %}

{% if inventory_hostname_short.startswith('ohpc-huawei-repo') %}
	{% if type == 'el' %}
		network --hostname=ohpc-huawei-sms --device=enp125s0f0 --ip=192.168.29.54 --netmask=255.255.0.0 --gateway=192.168.24.1 --bootproto=static --nameserver=8.8.8.8
	{% elif type == 'openeuler' %}
		network --hostname=ohpc-huawei-sms --device=enp125s0f0 --ip=192.168.29.54 --netmask=255.255.0.0 --gateway=192.168.24.1 --bootproto=static --nameserver=8.8.8.8
	{% endif %}
{% endif %}

ignoredisk --only-use={{ disks }}
bootloader --location=mbr --boot-drive=sda --append="quiet"
clearpart --all --initlabel --drives={{ disks }}
autopart
timezone UTC --utc

url --url http://{{ repo }}/{{base}}


{% if type == 'el' %}
repo --cost=1 --install --name="BaseOS" --baseurl="http://{{ repo }}/{{base}}BaseOS/"
repo --cost=1 --install --name="AppStream" --baseurl="http://{{ repo }}/{{base}}/AppStream/"
{% elif type == 'openeuler' %}
repo --cost=1 --install --name="DVD" --baseurl="http://{{ repo }}/{{ base }}"
{% endif %}
{% if not mirrors_in_post %}
{% for name, url in mirrors %}
repo --cost=50 --install --name="{{ name }}" --baseurl="{{ url }}" --proxy="http://{{ proxy }}"
{% endfor %}
{% endif %}


skipx
services --enabled="chronyd"

rootpw --iscrypted {{ root_password_crypted }}

{% if type == 'openeuler' and inventory_hostname_short.startswith('ohpc-lenovo-repo') %}
# the network card firmware requires a real reboot
reboot
{% else %}
reboot --kexec
{% endif %}

%pre-install
# Fetch fake URLs on the repo server to track installation progress.
# Each curl call creates an httpd access log entry, so tailing the log
# on {{ repo }} shows which kickstart step is currently executing.
curl -so /dev/null http://{{ repo }}/kickstart-progress/pre-install-{{ distro }} || true
%end

%post
set -x
export https_proxy=http://{{ proxy }}
export http_proxy=http://{{ proxy }}

curl -so /dev/null http://{{ repo }}/kickstart-progress/post-started-{{ distro }} || true

{% if mirrors_in_post %}
# The external mirrors are not used during the installation. Add them
# with skip_if_unavailable so that an unreachable mirror does not break
# the upgrade, with a cost below the default repositories.
{% for name, url in mirrors %}
cat > /etc/yum.repos.d/{{ name }}.repo <<EOF
[{{ name }}]
name={{ name }}
baseurl={{ url }}
proxy=http://{{ proxy }}
cost=50
enabled=1
gpgcheck=0
skip_if_unavailable=1
EOF
{% endfor %}
{% else %}
{% for name, url in mirrors %}
	echo "gpgcheck=0" >> /etc/yum.repos.d/{{ name }}.repo
{% endfor %}
{% endif %}

{% if type == 'el' %}
	echo "gpgcheck=0" >> /etc/yum.repos.d/BaseOS.repo
	echo "gpgcheck=0" >> /etc/yum.repos.d/AppStream.repo
{% if distro.startswith('rocky') and inventory_hostname_short.startswith('ohpc-huawei-repo') %}
	# The Rocky mirrorlist service does not return usable mirrors from
	# the Huawei lab. Use a fixed mirror in China instead.
	sed -e 's,^mirrorlist=,#mirrorlist=,' \
	    -e 's,^#baseurl=http://dl\.rockylinux\.org/\$contentdir/,baseurl=http://mirrors.nju.edu.cn/rocky/,' \
	    -i /etc/yum.repos.d/rocky*.repo
{% endif %}
	curl -so /dev/null http://{{ repo }}/kickstart-progress/epel-install-{{ distro }} || true
	dnf -y install epel-release
	/usr/bin/crb enable
	curl -so /dev/null http://{{ repo }}/kickstart-progress/repos-configured-{{ distro }} || true
{% elif type == 'openeuler' %}
	# the openeuler 22.03 kernel cannot handle zstd compressed firmware, but openeuler ships it that way
	curl -so /dev/null http://{{ repo }}/kickstart-progress/firmware-fix-{{ distro }} || true
	zstd -d /usr/lib/firmware/qed/qed_init_values_zipped-8.42.2.0.bin.zst || true
	dracut --force --kver $(rpm -q --queryformat '%{version}-%{release}.%{arch}' kernel)

	echo "gpgcheck=0" >> /etc/yum.repos.d/DVD.repo
	sed -i "s,\(metalink\),#\1,g" -i /etc/yum.repos.d/openEuler.repo
	sed -e "s,\(baseurl=http\)s,\1,g" -i /etc/yum.repos.d/openEuler.repo

	sed -i "s@http://repo.openeuler.org/@{{ mirror1 }}@g" /etc/yum.repos.d/openEuler.repo

	sed '/Banner/d;/AllowTcpForwarding/d;/AllowAgentForwarding/d;/GatewayPorts/d;/PermitTunnel/d;' -i /etc/ssh/sshd_config
	sed 's,/usr/libexec/openssh/openssh/sftp-server,/usr/libexec/openssh/sftp-server,g;' -i /etc/ssh/sshd_config
	curl -so /dev/null http://{{ repo }}/kickstart-progress/repos-configured-{{ distro }} || true
{% endif %}

curl -so /dev/null http://{{ repo }}/kickstart-progress/dnf-upgrade-{{ distro }} || true
dnf -y upgrade
curl -so /dev/null http://{{ repo }}/kickstart-progress/dnf-upgrade-done-{{ distro }} || true
mkdir -p /root/.ssh/
curl -o /root/.ssh/authorized_keys http://{{ repo }}/authorized_keys
cp /root/.ssh/authorized_keys /root/.ssh/jumper.pub
curl -so /dev/null http://{{ repo }}/kickstart-progress/ssh-keygen-{{ distro }} || true
ssh-keygen -t rsa -f /root/.ssh/cluster -N '' > /root/keygen.output
ssh-keygen -t rsa -f /root/.ssh/id_rsa -N '' >> /root/keygen.output
ssh-keygen -t ed25519 -f /root/.ssh/id_ed25519 -N '' >> /root/keygen.output
ssh-keygen -t dsa -f /root/.ssh/id_dsa -N '' >> /root/keygen.output
cat /root/.ssh/cluster.pub >> /root/.ssh/authorized_keys
curl -so /dev/null http://{{ repo }}/kickstart-progress/bootdev-disk-{{ distro }} || true
ipmitool chassis bootdev disk
mkdir -p /root/.cpan/CPAN/
curl -o /root/.cpan/CPAN/MyConfig.pm http://{{ repo }}/MyConfig.pm
curl -so /dev/null http://{{ repo }}/kickstart-progress/post-complete-{{ distro }} || true
%end
